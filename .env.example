PORT=3000
YOUTUBE_API_KEY=your_youtube_data_api_key_here
ADMIN_PIN=1234
MAX_QUEUE_PER_DEVICE=2
MAX_TRACK_MINUTES=10
REQUEST_COOLDOWN_MINUTES=2

# Browser Player uses YouTube directly. Keep this false on small Render instances.
ENABLE_DIRECT_AUDIO=false

# Public request page used by QR codes (configure DNS/HTTPS separately)
PUBLIC_URL=https://karaoke.uwaver.site

# Optional room limits and storage directory (Render Free storage is ephemeral)
MAX_ROOMS=20
# KARAOKE_DATA_DIR=/path/to/data

# Optional: persist room IDs, names and PIN hashes only in Firestore (Spark).
# Queue/history/catalog remain local. Never place service-account JSON in public/.
# ROOM_STORAGE=firestore
# Recommended: dedicated Firebase Auth Email/Password account (no service-account key).
# FIREBASE_PROJECT_ID=karaoke-uwaver
# FIREBASE_API_KEY=your_web_config_api_key
# FIREBASE_AUTH_EMAIL=your_backend_account_email
# FIREBASE_AUTH_PASSWORD=your_backend_account_password
# Optional alternative if service-account keys are allowed:
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"karaoke-uwaver","client_email":"...","private_key":"..."}

PORT=3000
YOUTUBE_API_KEY=your_youtube_data_api_key_here
ADMIN_PIN=1234
MAX_QUEUE_PER_DEVICE=2
MAX_TRACK_MINUTES=10
REQUEST_COOLDOWN_MINUTES=2

# Browser Player uses YouTube directly. Keep this false on small Render instances.
ENABLE_DIRECT_AUDIO=false

# Public request page used by QR codes (configure DNS/HTTPS separately)
PUBLIC_URL=https://karaoke.uwaver.site

# Optional room limits and storage directory (Render Free storage is ephemeral)
MAX_ROOMS=20
# KARAOKE_DATA_DIR=/path/to/data

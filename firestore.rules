rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace with the UID of ONE dedicated backend user from Authentication > Users.
    // Other users (including newly registered accounts) receive no access.
    match /karaokeRooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid == 'REPLACE_WITH_BACKEND_USER_UID';
      allow create: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_BACKEND_USER_UID'
        && roomId.matches('^[A-F0-9]{8}$')
        && request.resource.data.keys().hasAll(['name', 'salt', 'pinHash', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'salt', 'pinHash', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.salt is string
        && request.resource.data.salt.matches('^[a-f0-9]{32}$')
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.matches('^[a-f0-9]{64}$')
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt >= 0;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
